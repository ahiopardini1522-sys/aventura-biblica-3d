[node name="Board" type="Node3D" parent="World"]
unique_name_in_owner = true
script = ExtResource("3_builder")

[node name="Tokens" type="Node3D" parent="World"]
unique_name_in_owner = true

[node name="Dice" parent="World" instance=ExtResource("4_dice")]
unique_name_in_owner = true

[node name="Effects" type="Node3D" parent="World"]
unique_name_in_owner = true

[node name="BoardCamera" type="Camera3D" parent="World"]
unique_name_in_owner = true
current = true
fov = 45.0
far = 400.0
script = ExtResource("5_camera")

[node name="Flow" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("9_flow")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Hud" parent="UI" instance=ExtResource("6_hud")]
unique_name_in_owner = true

[node name="ChallengeLayer" type="CanvasLayer" parent="."]
layer = 5

[node name="ChallengePanel" parent="ChallengeLayer" instance=ExtResource("7_panel")]
unique_name_in_owner = true

[node name="PauseLayer" type="CanvasLayer" parent="."]
