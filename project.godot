; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aventura Bíblica 3D"
config/description="Escaleras y serpientes bíblico en 3D para Android."
config/version="0.4.0-alfa.1"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/quit_on_go_back=false
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.07, 0.15, 1)
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://scripts/game/settings_manager.gd"
ProgressManager="*res://scripts/game/progress_manager.gd"
GameState="*res://scripts/game/game_state.gd"
SceneRouter="*res://scripts/game/scene_router.gd"
OnlineManager="*res://scripts/online/online_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/fallback="es"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.15, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
